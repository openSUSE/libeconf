.SH "NAME"
(*econf\&.File)\&.Groups, (*econf\&.File)\&.Keys \- list the groups and keys of a configuration file

.SH "SYNOPSIS"

.sp
.ft B
.nf
import "github\&.com/openSUSE/libeconf/bindings/go/econf"
.fi
.ft
.sp
.nf
\fBfunc (f *econf\&.File) Groups() ([]string, error)\fR

\fBfunc (f *econf\&.File) Keys(group string) ([]string, error)\fR
.fi

.SH "DESCRIPTION"

.PP
\fB(*File)\&.Groups\fR
returns all group names found in
\fIf\fR\&.

.PP
\fB(*File)\&.Keys\fR
returns all keys in the given
\fIgroup\fR\&. If
\fIgroup\fR
is
""\&, keys from all groups (and keys outside of any group) are returned\&.

.SH "RETURN VALUE"

.PP
On success, these functions return a slice of strings and a
\fInil\fR
error\&. The slice is
\fInil\fR
if there is nothing to return\&.

.PP
On failure, they return
\fInil\fR
and a non\-nil
\fI*econf\&.Error\fR
(see
\fBeconf_go_Error\fR(3))\&.

.SH "ERRORS"

.PP
\fBeconf\&.ErrNoGroup\fR
.RS 4
          \fBKeys\fR
only: the specified
\fIgroup\fR
could not be found\&.
.RE

.PP
\fBeconf\&.ErrNoMem\fR
.RS 4
          Insufficient memory to allocate the resulting array\&.
.RE

.SH "EXAMPLE"
.sp
.if n \{\
.RS 1
.\}
.nf

f, err := econf\&.ReadFile("/etc/example\&.conf", "=", "#")
if err != nil {
    log\&.Fatal(err)
}
defer f\&.Close()

groups, err := f\&.Groups()
if err != nil {
    log\&.Fatal(err)
}
for _, group := range groups {
    keys, err := f\&.Keys(group)
    if err != nil {
        log\&.Fatal(err)
    }
    for _, key := range keys {
        value, err := f\&.String(group, key)
        if err != nil {
            log\&.Fatal(err)
        }
        fmt\&.Printf("[%s] %s = %s\en", group, key, value)
    }
}

.fi
.if n \{\
.RE
.\}
.sp

