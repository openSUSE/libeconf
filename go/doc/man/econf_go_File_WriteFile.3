.SH "NAME"
(*econf\&.File)\&.WriteFile \- write the contents of an econf\&.File to disk

.SH "SYNOPSIS"

.sp
.ft B
.nf
import "github\&.com/openSUSE/libeconf/go/econf"
.fi
.ft
.sp
.nf
\fBfunc (f *econf\&.File) WriteFile(saveToDir, fileName string) error\fR
.fi

.SH "DESCRIPTION"

.PP
\fB(*File)\&.WriteFile\fR
writes
\fIf\fR's contents to
\fIsaveToDir\fR/\fIfileName\fR\&.

.SH "RETURN VALUE"

.PP
On success,
\fBWriteFile\fR
returns
\fInil\fR\&.

.PP
On failure, it returns a non\-nil
\fI*econf\&.Error\fR
(see
\fBeconf_go_Error\fR(3))\&.

.SH "ERRORS"

.PP
\fBeconf\&.ErrWriteError\fR
.RS 4
          The file could not be created or written to\&.
.RE

.PP
\fBeconf\&.ErrNoMem\fR
.RS 4
          Insufficient memory while assembling the file contents\&.
.RE

.SH "EXAMPLE"
.sp
.if n \{\
.RS 1
.\}
.nf

f, err := econf\&.NewIniFile()
if err != nil {
    log\&.Fatal(err)
}
defer f\&.Close()

if err := f\&.SetString("main", "greeting", "hello"); err != nil {
    log\&.Fatal(err)
}
if err := f\&.WriteFile("/tmp", "example\&.conf"); err != nil {
    log\&.Fatal(err)
}

.fi
.if n \{\
.RE
.\}
.sp

