.SH "NAME"
econf\&.ReadFile, econf\&.ReadFileWithCallback \- parse a single configuration file

.SH "SYNOPSIS"

.sp
.ft B
.nf
import "github\&.com/openSUSE/libeconf/go/econf"
.fi
.ft
.sp
.nf
\fBfunc ReadFile(fileName, delim, comment string) (*econf\&.File, error)\fR

\fBfunc ReadFileWithCallback(fileName, delim, comment string, callback econf\&.FileCallback) (*econf\&.File, error)\fR
.fi

.SH "DESCRIPTION"

.PP
\fBReadFile\fR
parses
\fIfileName\fR
and returns its contents as a
\fI*econf\&.File\fR\&.

.PP
The
\fIdelim\fR
parameter specifies the character(s) used to separate keys from values
(e\&.g\&.,
"="
)\&. If
\fIdelim\fR
contains space characters AND non\-space characters, multiline values are
not parseable\&.
The
\fIcomment\fR
parameter specifies an array of characters which define the start of a
comment (e\&.g\&.,
"#"
)\&.

.PP
\fBReadFileWithCallback\fR
behaves like
\fBReadFile\fR, additionally invoking
\fIcallback\fR
(see
\fBeconf_go_FileCallback\fR(3)) with the candidate path before parsing it\&.
Returning
\fIfalse\fR
from
\fIcallback\fR
aborts the read, and the call fails with
\fBeconf\&.ErrParsingCallbackFailed\fR\&.

.PP
The returned
\fI*File\fR
should be released with
\fB(*File)\&.Close\fR
(see
\fBeconf_go_File_Close\fR(3)) once it is no longer needed\&.

.SH "RETURN VALUE"

.PP
On success, these functions return a non\-nil
\fI*econf\&.File\fR
and a
\fInil\fR
error\&.

.PP
On failure, they return
\fInil\fR
and a non\-nil
\fI*econf\&.Error\fR
(see
\fBeconf_go_Error\fR(3))\&.

.SH "ERRORS"

.PP
\fBeconf\&.ErrNoFile\fR
.RS 4
          The specified
\fIfileName\fR
does not exist\&.
.RE

.PP
\fBeconf\&.ErrNoMem\fR
.RS 4
          Insufficient memory to allocate the resulting
\fBeconf\&.File\fR\&.
.RE

.PP
\fBeconf\&.ErrMissingBracket\fR, \fBeconf\&.ErrTextAfterSection\fR, \fBeconf\&.ErrEmptySectionName\fR, \fBeconf\&.ErrMissingDelimiter\fR
.RS 4
          The file contains syntax errors and could not be parsed successfully\&.
.RE

.PP
\fBeconf\&.ErrArgumentIsNullValue\fR
.RS 4
          One of the required arguments is empty when it must not be\&.
.RE

.PP
\fBeconf\&.ErrParsingCallbackFailed\fR
.RS 4
          \fBReadFileWithCallback\fR
only: the callback returned
\fIfalse\fR\&.
.RE

.SH "EXAMPLE"
.sp
.if n \{\
.RS 1
.\}
.nf

package main

import (
    "log"

    "github\&.com/openSUSE/libeconf/go/econf"
)

func main() {
    f, err := econf\&.ReadFile("/etc/example/example\&.conf", "=", "#")
    if err != nil {
        log\&.Fatal(err)
    }
    defer f\&.Close()

    value, err := f\&.String("main", "greeting")
    if err != nil {
        log\&.Fatal(err)
    }
    log\&.Println(value)
}

.fi
.if n \{\
.RE
.\}
.sp

