.SH "NAME"
econf\&.MergeFiles \- merge the contents of two econf\&.File objects

.SH "SYNOPSIS"

.sp
.ft B
.nf
import "github\&.com/openSUSE/libeconf/go/econf"
.fi
.ft
.sp
.nf
\fBfunc MergeFiles(usrFile, etcFile *econf\&.File) (*econf\&.File, error)\fR
.fi

.SH "DESCRIPTION"

.PP
\fBMergeFiles\fR
merges
\fIetcFile\fR
on top of
\fIusrFile\fR; entries in
\fIetcFile\fR
win over entries with the same group/key in
\fIusrFile\fR\&.

.PP
Neither
\fIusrFile\fR
nor
\fIetcFile\fR
is modified or closed by this call; both remain independently usable and
must still be closed by the caller\&. The returned
\fI*File\fR
should be released with
\fB(*File)\&.Close\fR
(see
\fBeconf_go_File_Close\fR(3)) once it is no longer needed\&.

.SH "RETURN VALUE"

.PP
On success,
\fBMergeFiles\fR
returns a non\-nil
\fI*econf\&.File\fR
holding the merged configuration, and a
\fInil\fR
error\&.

.PP
On failure, it returns
\fInil\fR
and a non\-nil
\fI*econf\&.Error\fR
(see
\fBeconf_go_Error\fR(3))\&.

.SH "ERRORS"

.PP
\fBeconf\&.ErrNoMem\fR
.RS 4
          Insufficient memory to allocate the merged
\fBeconf\&.File\fR\&.
.RE

.PP
\fBeconf\&.ErrArgumentIsNullValue\fR
.RS 4
          \fIusrFile\fR
or
\fIetcFile\fR
is
\fInil\fR\&.
.RE

.SH "EXAMPLE"
.sp
.if n \{\
.RS 1
.\}
.nf

package main

import (
    "log"

    "github\&.com/openSUSE/libeconf/go/econf"
)

func main() {
    usr, err := econf\&.ReadFile("/usr/etc/example\&.conf", "=", "#")
    if err != nil {
        log\&.Fatal(err)
    }
    defer usr\&.Close()

    etc, err := econf\&.ReadFile("/etc/example\&.conf", "=", "#")
    if err != nil {
        log\&.Fatal(err)
    }
    defer etc\&.Close()

    merged, err := econf\&.MergeFiles(usr, etc)
    if err != nil {
        log\&.Fatal(err)
    }
    defer merged\&.Close()
}

.fi
.if n \{\
.RE
.\}
