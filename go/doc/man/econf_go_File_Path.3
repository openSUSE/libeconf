.SH "NAME"
(*econf\&.File)\&.Path \- evaluate the path name of the regarding configuration file

.SH "SYNOPSIS"

.sp
.ft B
.nf
import "github\&.com/openSUSE/libeconf/go/econf"
.fi
.ft
.sp
.nf
\fBfunc (f *econf\&.File) Path() string\fR
.fi

.SH "DESCRIPTION"

.PP
\fB(*File)\&.Path\fR
returns the absolute path of the file
\fIf\fR
was parsed from\&.

.SH "RETURN VALUE"

.PP
\fBPath\fR
returns the absolute path of the parsed file, or an empty string for
already\-merged data (e\&.g\&., a
\fI*File\fR
returned by
\fBMergeFiles\fR, see
\fBeconf_go_MergeFiles\fR(3))\&.

.SH "ERRORS"

.PP
This function does not return an error\&.

.SH "EXAMPLE"
.sp
.if n \{\
.RS 1
.\}
.nf

f, err := econf\&.ReadFile("/etc/example\&.conf", "=", "#")
if err != nil {
    log\&.Fatal(err)
}
defer f\&.Close()

fmt\&.Println(f\&.Path())

.fi
.if n \{\
.RE
.\}
.sp

.SH "SEE ALSO"

.PP
\fBeconf_go\fR(3),
\fBeconf_go_ReadFile\fR(3),
\fBeconf_go_MergeFiles\fR(3),
\fBeconf_getPath\fR(3)\&.
