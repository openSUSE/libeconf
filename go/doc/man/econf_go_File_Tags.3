.SH "NAME"
(*econf\&.File)\&.CommentTag, (*econf\&.File)\&.SetCommentTag, (*econf\&.File)\&.DelimiterTag, (*econf\&.File)\&.SetDelimiterTag \- get/set the comment and delimiter characters of a configuration file

.SH "SYNOPSIS"

.sp
.ft B
.nf
import "github\&.com/openSUSE/libeconf/go/econf"
.fi
.ft
.sp
.nf
\fBfunc (f *econf\&.File) CommentTag() byte\fR

\fBfunc (f *econf\&.File) SetCommentTag(comment byte)\fR

\fBfunc (f *econf\&.File) DelimiterTag() byte\fR

\fBfunc (f *econf\&.File) SetDelimiterTag(delimiter byte)\fR
.fi

.SH "DESCRIPTION"

.PP
\fB(*File)\&.CommentTag\fR
returns the comment character tag of
\fIf\fR, and
\fB(*File)\&.SetCommentTag\fR
sets it to
\fIcomment\fR\&.

.PP
\fB(*File)\&.DelimiterTag\fR
returns the key/value delimiter character of
\fIf\fR, and
\fB(*File)\&.SetDelimiterTag\fR
sets it to
\fIdelimiter\fR\&.

.PP
Changing these tags affects how
\fIf\fR
is written back by
\fB(*File)\&.WriteFile\fR
(see
\fBeconf_go_File_WriteFile\fR(3)); it does not re\-parse already\-loaded
content\&.

.SH "RETURN VALUE"

.PP
\fBCommentTag\fR
and
\fBDelimiterTag\fR
return the respective character\&.
\fBSetCommentTag\fR
and
\fBSetDelimiterTag\fR
return nothing\&.

.SH "ERRORS"

.PP
These functions do not return an error\&.

.SH "EXAMPLE"
.sp
.if n \{\
.RS 1
.\}
.nf

f, err := econf\&.NewIniFile()
if err != nil {
    log\&.Fatal(err)
}
defer f\&.Close()

fmt\&.Printf("delimiter: %c, comment: %c\en", f\&.DelimiterTag(), f\&.CommentTag())

f\&.SetCommentTag(\*(Aq;\*(Aq)
f\&.SetDelimiterTag(\*(Aq \*(Aq)

.fi
.if n \{\
.RE
.\}
.sp

